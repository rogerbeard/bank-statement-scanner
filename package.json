{
  "name": "bank-statement-scanner",
  "productName": "Bank Statement Scanner",
  "version": "1.1.4",
  "description": "AI-powered bank statement PDF scanner and data grid generator",
  "main": "electron/main.js",
  "author": {
    "name": "Bank Statement Scanner"
  },
  "license": "MIT",
  "scripts": {
    "install:all": "npm install && cd renderer && npm install",
    "dev": "concurrently --kill-others \"npm run server:dev\" \"npm run renderer:dev\" \"wait-on http://localhost:5173 && electron .\"",
    "server:dev": "PORT=47291 node server/index.js",
    "renderer:dev": "cd renderer && npm run dev",
    "build:renderer": "cd renderer && npm run build",
    "build": "npm run build:renderer && electron-builder --mac --x64 --arm64",
    "dist": "npm run build:renderer && electron-builder --mac",
    "dist:dmg": "npm run build:renderer && electron-builder --mac dmg",
    "pack": "npm run build:renderer && electron-builder --mac --dir",
    "start": "PORT=47291 node server/index.js",
    "start:browser": "bash start.sh",
    "postinstall": "echo 'skipping install-app-deps'"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.44",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^2.0.0",
    "pdfjs-dist": "^4.4.168",
    "sharp": "^0.33.5",
    "uuid": "^11.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.bankstatementscanner.app",
    "productName": "Bank Statement Scanner",
    "copyright": "Copyright © 2026 Bank Statement Scanner",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "renderer/dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!node_modules/.bin",
      "!node_modules/.cache",
      "!renderer/node_modules",
      "!renderer/src",
      "!**/*.map",
      "!**/node_modules/.cache",
      "!**/node_modules/electron/dist"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build-resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Bank Statement Scanner 1.1.4",
      "icon": "build-resources/icon.icns",
      "background": "build-resources/dmg-background.png",
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 180,
          "y": 170,
          "type": "file"
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
